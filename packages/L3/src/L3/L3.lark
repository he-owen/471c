%ignore /[\s]+/

program     : "(" PROGRAM "(" parameters ")" term ")"
parameters  : IDENTIFIER*

term        : let
            | letrec
            | reference
            | abstract
            | apply
            | immediate
            | primitive
            | branch
            | if_term
            | bool_true
            | bool_false
            | and_expr
            | or_expr
            | not_expr
            | print_expr
            | string_literal
            | string_length
            | allocate
            | load
            | store
            | begin


let         : "(" LET "(" bindings ")" term ")"
letrec      : "(" LETREC "(" bindings ")" term ")"
reference   : IDENTIFIER
abstract    : "(" LAMBDA "(" parameters ")" term ")"
immediate   : INTEGER
primitive   : "(" PRIMITIVE_OP term term ")"
branch      : "(" IF "(" CMP_OP term term ")" term term ")"
if_term     : "(" IF term term term ")"
bool_true   : BOOL_TRUE
bool_false  : BOOL_FALSE
and_expr    : "(" AND term term ")"
or_expr     : "(" OR term term ")"
not_expr    : "(" NOT term ")"
print_expr  : "(" PRINT term ")"
string_literal : STRING
string_length  : "(" STRING_LENGTH term ")"
allocate    : "(" ALLOCATE term ")"
load        : "(" LOAD term term ")"
store       : "(" STORE term term term ")"
begin       : "(" BEGIN term+ ")"
apply       : "(" term term* ")"

bindings    : binding*
binding     : "(" IDENTIFIER term ")"

PROGRAM.2   : "l3"
LET.2       : "let"
LETREC.2    : "letrec"
LAMBDA.2    : "\\" | "lambda" | "λ"
IF.2        : "if"
ALLOCATE.2  : "allocate"
LOAD.2      : "load"
STORE.2     : "store"
BEGIN.2     : "begin"
AND.2       : "and"
OR.2        : "or"
NOT.2       : "not"
BOOL_TRUE.2 : "#t"
BOOL_FALSE.2: "#f"
PRINT.2     : "print"
STRING_LENGTH.2 : "string-length"

PRIMITIVE_OP.2 : "+" | "-" | "*" | "/" | "%" | "string-ref" | "string-append"
CMP_OP      : "<" | "==" | ">" | ">=" | "<=" | "!="

IDENTIFIER  : /[a-zA-Z_][a-zA-Z0-9_]*/
INTEGER     : /0|[1-9][0-9]*/
STRING      : /\"[^\"]*\"/